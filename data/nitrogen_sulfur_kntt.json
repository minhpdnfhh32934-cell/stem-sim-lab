    {
      "id": "s",
      "element": "S",
      "formula": "S",
      "name": {
        "vi": "Sulfur",
        "en": "Sulfur"
      },
      "lesson": 7,
      "facts": [
        {
          "text": {
            "vi": "Nguyên tố phổ biến thứ 17 trên vỏ Trái Đất, khoảng 0,03 – 0,1% khối lượng.",
            "en": "The 17th most common element in the Earth's crust, about 0.03–0.1% of its mass."
          },
          "page": 42
        },
        {
          "text": {
            "vi": "Bốn đồng vị bền: ³²S (94,98%), ³³S (0,76%), ³⁴S (4,22%), ³⁶S (0,02%).",
            "en": "Four stable isotopes: ³²S (94.98%), ³³S (0.76%), ³⁴S (4.22%), ³⁶S (0.02%)."
          },
          "page": 42
        },
        {
          "text": {
            "vi": "Ô số 16, nhóm VIA, chu kì 3; độ âm điện 2,58; số oxi hóa từ −2 đến +6.",
            "en": "Atomic number 16, group VIA, period 3; electronegativity 2.58; oxidation numbers −2 to +6."
          },
          "page": 43
        },
        {
          "text": {
            "vi": "Phân tử S₈ dạng vòng; liên kết S–S 226 kJ/mol, dài 205 pm.",
            "en": "Ring-shaped S₈ molecules; S–S bonds of 226 kJ/mol and 205 pm."
          },
          "page": 43
        },
        {
          "text": {
            "vi": "Không tan trong nước, ít tan trong alcohol, tan nhiều trong carbon disulfide; nóng chảy ở 113 °C, sôi ở 445 °C.",
            "en": "Insoluble in water, slightly soluble in alcohol, very soluble in carbon disulfide; melts at 113 °C, boils at 445 °C."
          },
          "page": 43
        },
        {
          "text": {
            "vi": "Hai dạng thù hình tà phương và đơn tà, chuyển nhau ở 95,5 °C.",
            "en": "Two allotropes, rhombic and monoclinic, which change into each other at 95.5 °C."
          },
          "page": 44
        }
      ],
      "review_status": "pending"
    },
    {
      "id": "so2",
      "element": "S",
      "formula": "SO2",
      "name": {
        "vi": "Sulfur dioxide",
        "en": "Sulfur dioxide"
      },
      "lesson": 7,
      "facts": [
        {
          "text": {
            "vi": "Khí không màu, nặng hơn không khí, mùi hắc; ở 20 °C, 1 lít nước hòa tan được 40 lít sulfur dioxide.",
            "en": "A colourless gas, heavier than air, with a pungent smell; at 20 °C, 1 L of water dissolves 40 L of sulfur dioxide."
          },
          "page": 45
        },
        {
          "text": {
            "vi": "Khí độc: hít phải lượng vượt ngưỡng gây viêm đường hô hấp.",
            "en": "Toxic: breathing it above the limit inflames the airways."
          },
          "page": 45
        },
        {
          "text": {
            "vi": "S có số oxi hóa +4: sulfur dioxide vừa có tính oxi hóa vừa có tính khử.",
            "en": "S is at +4: sulfur dioxide is both an oxidising and a reducing agent."
          },
          "page": 46
        }
      ],
      "review_status": "pending"
    },
    {
      "id": "h2so4",
      "element": "S",
      "formula": "H2SO4",
      "name": {
        "vi": "Sulfuric acid",
        "en": "Sulfuric acid"
      },
      "lesson": 8,
      "facts": [
        {
          "text": {
            "vi": "Chất lỏng sánh như dầu, không màu, không bay hơi, hút ẩm mạnh.",
            "en": "An oily, colourless, non-volatile liquid that takes up water strongly."
          },
          "page": 49
        },
        {
          "text": {
            "vi": "Dung dịch 98% có khối lượng riêng 1,84 g/cm³, nặng gần gấp hai lần nước.",
            "en": "The 98% solution has a density of 1.84 g/cm³, nearly twice that of water."
          },
          "page": 49
        },
        {
          "text": {
            "vi": "Tan vô hạn trong nước và tỏa rất nhiều nhiệt: khi pha loãng phải rót từ từ acid vào nước, không làm ngược lại.",
            "en": "Mixes with water in all proportions, giving off much heat: to dilute it, pour the acid slowly into water, never the reverse."
          },
          "page": 49
        }
      ],

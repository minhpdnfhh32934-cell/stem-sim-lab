  "items": [
    {
      "id": "n2",
      "element": "N",
      "formula": "N2",
      "name": {
        "vi": "Nitrogen",
        "en": "Nitrogen"
      },
      "lesson": 4,
      "facts": [
        {
          "text": {
            "vi": "Chiếm 75,5% khối lượng (78,1% thể tích) khí quyển Trái Đất.",
            "en": "75.5% of the mass (78.1% of the volume) of the Earth's atmosphere."
          },
          "page": 29
        },
        {
          "text": {
            "vi": "Hai đồng vị bền: ¹⁴N (99,63%) và ¹⁵N (0,37%).",
            "en": "Two stable isotopes: ¹⁴N (99.63%) and ¹⁵N (0.37%)."
          },
          "page": 29
        },
        {
          "text": {
            "vi": "Ô số 7, nhóm VA, chu kì 2; độ âm điện 3,04; số oxi hóa từ −3 đến +5.",
            "en": "Atomic number 7, group VA, period 2; electronegativity 3.04; oxidation numbers −3 to +5."
          },
          "page": 30
        },
        {
          "text": {
            "vi": "Liên kết ba (1 σ, 2 π), năng lượng liên kết 945 kJ/mol, phân tử không phân cực.",
            "en": "A triple bond (1 σ, 2 π), bond energy 945 kJ/mol; a non-polar molecule."
          },
          "page": 30
        },
        {
          "text": {
            "vi": "Khí không màu, không mùi, không vị; hóa lỏng ở −196 °C; 1 lít nước hòa tan 0,012 lít khí nitrogen.",
            "en": "A colourless, odourless, tasteless gas; liquefies at −196 °C; 1 L of water dissolves 0.012 L of nitrogen."
          },
          "page": 30
        }
      ],
      "review_status": "pending"
    },
    {
      "id": "nh3",
      "element": "N",
      "formula": "NH3",
      "name": {
        "vi": "Ammonia",
        "en": "Ammonia"
      },
      "lesson": 5,
      "facts": [
        {
          "text": {
            "vi": "Phân tử dạng chóp tam giác; nguyên tử N còn một cặp electron không liên kết.",
            "en": "A trigonal pyramid; the N atom keeps one lone pair."
          },
          "page": 33
        },
        {
          "text": {
            "vi": "Liên kết N–H phân cực, năng lượng liên kết 386 kJ/mol.",
            "en": "Polar N–H bonds, bond energy 386 kJ/mol."
          },
          "page": 33
        },
        {
          "text": {
            "vi": "Khí không màu, nhẹ hơn không khí, mùi khai và xốc; 1 lít nước hòa tan khoảng 700 lít ammonia.",
            "en": "A colourless gas, lighter than air, with a sharp smell; 1 L of water dissolves about 700 L of ammonia."
          },
          "page": 34
        },
        {
          "text": {
            "vi": "Hóa lỏng ở −33,3 °C, hóa rắn ở −77,7 °C.",
            "en": "Liquefies at −33.3 °C, solidifies at −77.7 °C."
          },
          "page": 34
        },
        {
          "text": {
            "vi": "Dung dịch có môi trường base yếu: quỳ tím hóa xanh, phenolphthalein hóa hồng.",
            "en": "Its solution is weakly basic: litmus turns blue, phenolphthalein pink."
          },
          "page": 34
        },
        {
          "text": {
            "vi": "Sản xuất ở 400 °C – 450 °C, áp suất 150 – 200 bar, xúc tác Fe.",
            "en": "Made at 400–450 °C, 150–200 bar, with an iron catalyst."
          },
          "page": 35
        }
      ],
      "review_status": "pending"
    },
    {
      "id": "nh4",
      "element": "N",
      "formula": "NH4^+",
      "name": {
        "vi": "Ion ammonium",
        "en": "Ammonium ion"
      },
      "lesson": 5,
      "facts": [
        {
          "text": {
            "vi": "Hầu hết muối ammonium dễ tan và phân li hoàn toàn ra ion.",
            "en": "Most ammonium salts dissolve easily and dissociate completely."
          },
          "page": 36
        },
        {
          "text": {
            "vi": "Nhận biết: đun với dung dịch kiềm, có khí ammonia mùi khai bay ra.",
            "en": "Test: warmed with an alkali, it gives off ammonia with its sharp smell."
          },
          "page": 36
        },
        {
          "text": {
            "vi": "Muối ammonium kém bền nhiệt, dễ bị phân hủy khi nung nóng.",
            "en": "Ammonium salts are unstable to heat and decompose when heated."
          },
          "page": 36
        }
      ],
      "review_status": "pending"
    },
    {
      "id": "nox",
      "element": "N",
      "formula": "NO2",
      "name": {
        "vi": "Các oxide của nitrogen (NOₓ)",
        "en": "Nitrogen oxides (NOₓ)"
      },
      "lesson": 6,
      "facts": [
        {
          "text": {
            "vi": "N₂O dinitrogen oxide, NO nitrogen monoxide, NO₂ nitrogen dioxide, N₂O₄ dinitrogen tetroxide.",
            "en": "N₂O dinitrogen oxide, NO nitrogen monoxide, NO₂ nitrogen dioxide, N₂O₄ dinitrogen tetroxide."
          },
          "page": 38
        },
        {
          "text": {
            "vi": "Nước mưa thường có pH khoảng 5,6; mưa có pH nhỏ hơn 5,6 là mưa acid, tác động rõ nhất khi pH dưới 4,5.",
            "en": "Ordinary rain has a pH of about 5.6; rain below 5.6 is acid rain, most harmful below 4.5."
          },
          "page": 39
        },
        {
          "text": {
            "vi": "Phú dưỡng khi nitrogen trong nước đạt 300 µg/L và phosphorus đạt 20 µg/L.",
            "en": "Eutrophication sets in when nitrogen in water reaches 300 µg/L and phosphorus 20 µg/L."
          },
          "page": 40
        }
      ],
      "review_status": "pending"
    },
    {
      "id": "hno3",
      "element": "N",
      "formula": "HNO3",
      "name": {
        "vi": "Nitric acid",
        "en": "Nitric acid"
      },
      "lesson": 6,
      "facts": [
        {
          "text": {
            "vi": "N có số oxi hóa +5, cao nhất của nitrogen: nitric acid có tính oxi hóa mạnh.",
            "en": "N is at +5, nitrogen's highest: nitric acid is a strong oxidising agent."
          },
          "page": 39
        },
        {
          "text": {
            "vi": "Chất lỏng không màu, khối lượng riêng 1,53 g/mL; nóng chảy ở −42 °C, sôi ở 83 °C; tan vô hạn trong nước.",
            "en": "A colourless liquid of density 1.53 g/mL; melts at −42 °C, boils at 83 °C; mixes with water in all proportions."
          },
          "page": 39
        }
      ],
      "review_status": "pending"

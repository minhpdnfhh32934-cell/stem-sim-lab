{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STEM Sim Lab THPT",
  "identifier": "vn.stemsimlab.pilot",
  "build": {
    "beforeBuildCommand": "npm run build:pilot"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "STEM Sim Lab — bản thử nghiệm THPT",

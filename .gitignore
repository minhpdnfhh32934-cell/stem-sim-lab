# Dependencies
node_modules/

# Build output
dist/
src-tauri/target/
src-tauri/gen/schemas/

# Test / tooling output
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Editors / OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Local environment (API keys live in the OS keychain, never in files)
.env
.env.*
!.env.example
/release/

# onnxruntime binaries copied by scripts/copy-ort-wasm.mjs (postinstall)
public/ort/

# Claude Code watcher (scripts/agents/watch.ps1)
.agent-logs/

# MSIX packages built by scripts/store/make-msix.mjs
store/out/
# Local knowledge graph (graphify), rebuilt per machine
graphify-out/

# llama-server for "Qwen trong app" (#190), fetched by scripts/llama/fetch-llama-server.mjs;
# the llama.cpp licence that ships beside it stays in git
src-tauri/binaries/llama-server/*
!src-tauri/binaries/llama-server/LICENSE-llama.cpp.txt

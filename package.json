{
  "name": "stem-sim-lab",
  "private": true,
  "version": "0.8.2",
  "description": "SimLab — offline desktop simulator for Physics, Chemistry and Biology (Tauri + React)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postinstall": "node scripts/copy-ort-wasm.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:slow": "vitest run --mode slow src/physics/endless.slow.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test:e2e": "playwright test",
    "golden:llm": "vitest run --config vitest.llm.config.ts",
    "build:game": "node scripts/game/build.mjs",
    "release-notes": "node scripts/release-notes/build.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/pangolin": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@rdkit/rdkit": "^2026.9.1",
    "@tauri-apps/api": "^2.12.4",
    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "uplot": "^1.6.32",
    "zod": "^4.6.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
